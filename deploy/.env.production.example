# Copy this file to deploy/.env.production and keep the copy outside Git.
# Docker Compose uses this file both to interpolate ports and to configure api.

# Keep loopback until a company VPN, Cloudflare Access, or equivalent identity
# gateway is forwarding to this server. Never expose API port 8001 directly.
RADAR_HTTP_BIND=127.0.0.1
RADAR_HTTP_PORT=8080
RADAR_DOMAIN=radar.example.com
PUBLIC_API_URL=https://radar.example.com
PUBLIC_FRONTEND_URL=https://radar.example.com

# Required in production. Generate five accounts on the deployment host:
# python tools/create_internal_users.py --count 5
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_COOKIE_SECURE=true
INTERNAL_AUTH_TTL_SECONDS=43200
INTERNAL_AUTH_SECRET=
INTERNAL_USERS_JSON=[]
LEGACY_REPORT_MIGRATION_OWNER=local

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_AGENT_MODEL=deepseek-v4-flash
LLM_ANALYSIS_MODEL=deepseek-v4-pro

SEC_ENABLED=true
SEC_USER_AGENT=ETF Theme Radar operations@example.com
OPENALEX_ENABLED=true
OPENALEX_MAILTO=operations@example.com
PATENTSVIEW_ENABLED=false
GOOGLE_PATENTS_ENABLED=true
JOB_BOARDS_ENABLED=true
ETF_HOLDINGS_ENABLED=true
YAHOO_ETF_NEWS_ENABLED=true
SP_GLOBAL_ENABLED=false
ANYSEARCH_ENABLED=true
PLAYWRIGHT_MCP_ENABLED=false
STARTUP_SYNC_ENABLED=true
