# Never commit a real key; copy this file to .env locally.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_AGENT_MODEL=deepseek-v4-flash
LLM_ANALYSIS_MODEL=deepseek-v4-pro
LLM_MAX_OUTPUT_TOKENS=1600

# Optional overrides; defaults live in config/defaults.yaml.
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_MODEL_REQUESTS=8
AGENT_MAX_SECONDS=720
AGENT_MAX_TOTAL_TOKENS=24000
AGENT_MAX_COST_USD=0.50
LLM_ESTIMATED_COST_PER_MILLION_TOKENS=2.00

SEC_ENABLED=true
SEC_USER_AGENT=
OPENALEX_ENABLED=true
OPENALEX_API_KEY=
OPENALEX_MAILTO=
PATENTSVIEW_ENABLED=false
GOOGLE_PATENTS_ENABLED=true
GOOGLE_PATENTS_QUERIES_JSON=["site:patents.google.com/patent artificial intelligence accelerator","site:patents.google.com/patent robotics semiconductor"]
JOB_BOARDS_ENABLED=true
JOB_BOARDS_JSON=[]
JOB_BOARDS_MAX_PER_RUN=6
ETF_HOLDINGS_ENABLED=true
ETF_HOLDINGS_FEEDS_JSON=
ETF_HOLDINGS_MAX_FEEDS_PER_RUN=6
YAHOO_ETF_NEWS_ENABLED=true
YAHOO_ETF_NEWS_MAX_TICKERS_PER_RUN=4
YAHOO_ETF_NEWS_MAX_ITEMS_PER_TICKER=8
SP_GLOBAL_ENABLED=false
SP_GLOBAL_RSS_FEEDS_JSON=
SP_GLOBAL_CACHE_TTL_SECONDS=300
ANYSEARCH_ENABLED=true
ANYSEARCH_QUERIES_JSON=["site:patents.google.com/patent artificial intelligence","site:seekingalpha.com AI infrastructure ETF"]
X_WATCHLIST_JSON=[]
PLAYWRIGHT_MCP_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx.cmd
DATABASE_PATH=data/radar.db
STARTUP_SYNC_ENABLED=true
